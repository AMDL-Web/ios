<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lyjw131.amdl.download</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>amdl</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问本地网络以连接开发调试用的 WebSocket 服务器。</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>需要访问 Apple Music 以获取 Music-User-Token。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>需要使用麦克风来识别正在播放的歌曲。</string>
	<!-- App 只使用标准 HTTPS/WSS 通信，以及 CryptoKit 的 SHA-256（把封面 URL
	     哈希成缓存文件名，属哈希而非加密），均在出口合规豁免范围内。声明在此
	     以免每次上传构建都要在 App Store Connect 上手动回答一次。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
